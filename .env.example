# Settings for `docker compose up`. Copy to .env (next to docker-compose.yml). Never commit .env.
# Everything is optional; the defaults give a working local stack.

POSTGRES_PASSWORD=nudgeiq
BACKEND_PORT=8000
FRONTEND_PORT=8080

# mock = offline stand-in (default). groq | gemini | openrouter = one free provider.
# chain = Groq, then Gemini, then OpenRouter, then mock. Model names: copy from each console.
NUDGEIQ_LLM=mock
GROQ_API_KEY=
NUDGEIQ_GROQ_MODEL=
NUDGEIQ_GROQ_MODEL_2=
GEMINI_API_KEY=
NUDGEIQ_GEMINI_MODEL=
OPENROUTER_API_KEY=
NUDGEIQ_OPENROUTER_MODEL=
# NUDGEIQ_LLM_TIMEOUT=60

# DEBUG, INFO (default), WARNING, ERROR, CRITICAL
# NUDGEIQ_LOG_LEVEL=INFO

# classic (default) or graph (LangGraph). Same decisions either way.
# NUDGEIQ_ENGINE=classic

# Background worker (Celery). Number of tasks it runs at the same time.
# WORKER_CONCURRENCY=2

# Scheduled sends (8d-2). 1 = nudges are stored and the worker delivers them at their send time.
# 0 = they are "sent" at once in the API log, as before.
# NUDGEIQ_SCHEDULED_SENDS=1
# How often (seconds, 5 or more) `beat` looks for due sends.
# NUDGEIQ_DISPATCH_INTERVAL_SECONDS=30
# A send found later than this many minutes after its time is skipped, not delivered late.
# NUDGEIQ_SEND_MAX_LATE_MINUTES=120

# ---- Outcomes in the background (8d-3b) ----
# 1 = POST /outcomes stores the outcome as pending, queues it and answers 202; a worker rewards
# and learns. Needs PostgreSQL, Redis and a running worker + beat. Off (default) = all done
# before the answer. Send an Idempotency-Key header so a retried request is stored once.
# NUDGEIQ_ASYNC_OUTCOMES=0
# Seconds an outcome may stay pending before the sweep queues it again (minimum 60, default 600).
# NUDGEIQ_OUTCOME_SWEEP_GRACE_SECONDS=600
