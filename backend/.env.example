# NudgeIQ backend settings. Copy to backend/.env and edit.
# Start the server with:  uvicorn app.api.main:app --reload --env-file .env
# Variables already set in your shell win over this file. In Docker, docker-compose.yml sets them.

# ---- Storage: pick ONE. If both are empty, data lives in memory and is lost on restart. ----
# PostgreSQL (recommended). Matches docker-compose.yml. Run `python -m app.repository.init_db` once.
NUDGEIQ_DATABASE_URL=postgresql://nudgeiq:nudgeiq@localhost:5432/nudgeiq
# Or a JSON file, for quick local use without a database:
# NUDGEIQ_DATA_FILE=data.json

# ---- Language model for "Generate variants" ----
# mock    = offline stand-in, no key needed (default).
# groq | gemini | openrouter = that one free provider.
# chain   = try Groq, then Gemini, then OpenRouter, and finish with the mock (demo never breaks).
NUDGEIQ_LLM=mock
# Free keys: console.groq.com, aistudio.google.com, openrouter.ai. Never commit a real key.
GROQ_API_KEY=
# Model names change often: copy the current ones from each provider's console.
NUDGEIQ_GROQ_MODEL=
# Optional smaller Groq model, tried if the first one fails (rate limit etc.)
NUDGEIQ_GROQ_MODEL_2=
GEMINI_API_KEY=
NUDGEIQ_GEMINI_MODEL=
OPENROUTER_API_KEY=
# Models ending in :free cost nothing
NUDGEIQ_OPENROUTER_MODEL=
# Optional. Seconds to wait for each model. Default 60.
# NUDGEIQ_LLM_TIMEOUT=60

# ---- Decision engine ----
# classic (default) = plain Python flow. graph = the same flow as a LangGraph (needs `langgraph`,
# which is in requirements.txt). Both give identical decisions; switch only after the tests pass.
# NUDGEIQ_ENGINE=classic

# ---- Background worker (Celery + Redis) ----
# Where Redis is. docker-compose.yml sets this for you. Must start with redis:// or rediss://.
# Run a worker by hand with:  celery -A app.worker.celery_app worker --loglevel=INFO
# Check that one is alive with:  python -m app.worker.check
# NUDGEIQ_REDIS_URL=redis://localhost:6379/0

# ---- Scheduled sends (8d-2) ----
# 1 = the API stores each nudge in PostgreSQL and the worker delivers it at its send time.
# Needs NUDGEIQ_DATABASE_URL (anything else stops start-up), plus a worker and `celery beat`:
#   celery -A app.worker.celery_app worker --loglevel=INFO
#   celery -A app.worker.celery_app beat --loglevel=INFO       (run exactly one)
# The worker needs the same NUDGEIQ_DATABASE_URL. Off (default) = nudges are "sent" at once in the log.
# NUDGEIQ_SCHEDULED_SENDS=1
# How often due sends are looked for, in seconds (5 or more).
# NUDGEIQ_DISPATCH_INTERVAL_SECONDS=30
# A send found more than this many minutes after its time is skipped, not delivered late
# (so a worker that was down all night does not text people at 3 a.m.).
# NUDGEIQ_SEND_MAX_LATE_MINUTES=120

# ---- Logging and browser access ----
# DEBUG, INFO (default), WARNING, ERROR, CRITICAL. A wrong value stops the server at start-up.
# NUDGEIQ_LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API straight from a browser. Normally leave unset:
# the Vite proxy and the nginx in docker-compose make the browser use a single origin.
# NUDGEIQ_CORS_ORIGINS=http://localhost:5173

# ---- Tests only ----
# An EMPTY throwaway database. The tests wipe it before each test. Never point at real data.
# NUDGEIQ_TEST_DSN=postgresql://nudgeiq:nudgeiq@localhost:5432/nudgeiq_test
# An empty throwaway Redis database for the one test that sends a real task. Use a spare db number.
# NUDGEIQ_TEST_REDIS=redis://localhost:6379/15

# ---- Outcomes in the background (8d-3b) ----
# 1 = POST /outcomes stores the outcome as pending, queues it and answers 202; a worker rewards
# and learns. Needs PostgreSQL, Redis and a running worker + beat. Off (default) = all done
# before the answer. Send an Idempotency-Key header so a retried request is stored once.
# NUDGEIQ_ASYNC_OUTCOMES=0
# Seconds an outcome may stay pending before the sweep queues it again (minimum 60, default 600).
# NUDGEIQ_OUTCOME_SWEEP_GRACE_SECONDS=600
